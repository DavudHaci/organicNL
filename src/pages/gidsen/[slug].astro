---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const gidsen = await getCollection('gidsen');
  return gidsen.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const dateFmt = new Intl.DateTimeFormat('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    inLanguage: 'nl-NL',
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: {
      '@type': 'Organization',
      name: 'CasinoHelder Redactie',
      url: new URL('/over-ons/', Astro.site).toString(),
    },
    publisher: { '@type': 'Organization', name: 'CasinoHelder' },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Gidsen',
        item: new URL('/gidsen/', Astro.site).toString(),
      },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];

if (d.faq?.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Base title={d.metaTitle} description={d.description} ogType="article" schema={schema}>
  <div class="container container--narrow">
    <header class="article-header">
      <nav class="breadcrumbs" aria-label="Kruimelpad">
        <a href="/">Home</a> &rsaquo; <a href="/gidsen/">Gidsen</a> &rsaquo; {d.title}
      </nav>
      <h1>{d.title}</h1>
      <div class="article-meta">
        <span class="cat-pill">{d.category}</span>
        <span>
          Laatst bijgewerkt:
          <time datetime={(d.updatedDate ?? d.pubDate).toISOString()}>
            {dateFmt.format(d.updatedDate ?? d.pubDate)}
          </time>
        </span>
        <span>{d.readingTime} min leestijd</span>
        <span>Door de CasinoHelder Redactie</span>
      </div>
    </header>

    <article class="prose">
      <Content />

      {
        d.faq?.length && (
          <>
            <h2>Veelgestelde vragen</h2>
            <div class="faq">
              {d.faq.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </>
        )
      }

      <div class="rg-banner">
        <strong>Gokken kan verslavend zijn. Speel bewust. 24+</strong> &mdash; Meer weten?
        Bekijk onze pagina over <a href="/verantwoord-spelen/">verantwoord spelen</a>.
      </div>
    </article>
  </div>
</Base>
