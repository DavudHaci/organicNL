---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const dateFmt = new Intl.DateTimeFormat('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: {
      '@type': 'Organization',
      name: d.brand,
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: d.rating,
      bestRating: 10,
      worstRating: 1,
    },
    name: d.title,
    author: {
      '@type': 'Organization',
      name: 'CasinoHelder Redactie',
      url: new URL('/over-ons/', Astro.site).toString(),
    },
    publisher: { '@type': 'Organization', name: 'CasinoHelder' },
    datePublished: d.pubDate.toISOString(),
    inLanguage: 'nl-NL',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.toString() },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Reviews',
        item: new URL('/reviews/', Astro.site).toString(),
      },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];

if (d.faq?.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Base title={d.metaTitle} description={d.description} ogType="article" schema={schema}>
  <div class="container container--narrow">
    <header class="article-header">
      <nav class="breadcrumbs" aria-label="Kruimelpad">
        <a href="/">Home</a> &rsaquo; <a href="/reviews/">Reviews</a> &rsaquo; {d.brand}
      </nav>
      <h1>{d.title}</h1>
      <div class="article-meta">
        <span class="cat-pill">Review</span>
        <span>
          Laatst bijgewerkt:
          <time datetime={(d.updatedDate ?? d.pubDate).toISOString()}>
            {dateFmt.format(d.updatedDate ?? d.pubDate)}
          </time>
        </span>
        <span>Door de CasinoHelder Redactie</span>
      </div>
    </header>

    <div class="review-hero">
      <img src={d.logo} alt={`${d.brand} logo`} width="140" height="76" loading="eager" />
      <div class="review-hero__body">
        <p class="review-hero__bonus">&#127873; {d.bonus}</p>
        <p class="review-hero__rating">
          Onze score: <strong>{d.rating}/10</strong> &middot; Internationale licentie &middot; 18+
        </p>
      </div>
      <a class="btn" href={d.link} rel="sponsored nofollow noopener" target="_blank">
        Claim bonus
      </a>
    </div>

    <article class="prose">
      <div class="pros-cons">
        <div class="pros-cons__col">
          <h3>&#10003; Pluspunten</h3>
          <ul>{d.pros.map((p) => <li>{p}</li>)}</ul>
        </div>
        <div class="pros-cons__col pros-cons__col--cons">
          <h3>&#10007; Minpunten</h3>
          <ul>{d.cons.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>

      <Content />

      {
        d.faq?.length && (
          <>
            <h2>Veelgestelde vragen over {d.brand}</h2>
            <div class="faq">
              {d.faq.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </>
        )
      }

      <div class="review-cta">
        <p><strong>{d.bonus}</strong></p>
        <a class="btn" href={d.link} rel="sponsored nofollow noopener" target="_blank">
          Speel bij {d.brand}
        </a>
        <p class="review-cta__terms">18+ &middot; Bonusvoorwaarden van toepassing &middot; Speel bewust</p>
      </div>

      <div class="rg-banner">
        <strong>Gokken kan verslavend zijn. Speel bewust. 24+</strong> &mdash; {d.brand} opereert
        onder een internationale licentie en valt niet onder toezicht van de Nederlandse
        Kansspelautoriteit. Meer weten? Bekijk onze pagina over
        <a href="/verantwoord-spelen/">verantwoord spelen</a>.
      </div>
    </article>
  </div>
</Base>
