---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const gidsen = (await getCollection('gidsen')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const casinos = [
  {
    rank: 1,
    name: 'SpinFin',
    logo: '/logos/spinfin.png',
    bonus: 'Casino Welcome Pack 350% tot \u20AC10.000 + 500 free spins',
    usp: 'Grootste welkomstpakket',
    license: 'Internationale licentie',
    review: '/reviews/spinfin/',
    link: 'https://go.driveaffiliates.com/visit/?bta=36349&nci=5369&utm_campaign=PPC-SpinFin-NL-DD&afp',
  },
  {
    rank: 2,
    name: 'X3Bet',
    logo: '/logos/x3bet.png',
    bonus: '200% tot \u20AC1.200 + 250 free spins',
    usp: 'Casino & sportweddenschappen',
    license: 'Internationale licentie',
    review: '/reviews/x3bet/',
    link: 'https://go.driveaffiliates.com/visit/?bta=36349&nci=5394&utm_campaign=PPC-X3Bet-NL-DD&afp',
  },
  {
    rank: 3,
    name: 'Atefia',
    logo: '/logos/atefia.png',
    bonus: 'Casino Welcome Bonus 200% tot \u20AC1.200 + 250 free spins',
    usp: 'Ruim spelaanbod',
    license: 'Internationale licentie',
    review: '/reviews/atefia/',
    link: 'https://go.driveaffiliates.com/visit/?bta=36349&nci=5455&utm_campaign=PPC-Atefia-NL-DD&afp',
  },
];

const faq = [
  {
    q: 'Welke online casino\u2019s zijn legaal in Nederland?',
    a: 'Alleen aanbieders met een vergunning van de Kansspelautoriteit (KSA) mogen legaal online kansspelen aanbieden in Nederland. Je herkent ze aan het KSA-logo met vergunningsnummer in de footer van de website. Daarnaast zijn er internationale aanbieders met een buitenlandse licentie; controleer altijd zelf de licentie en voorwaarden voordat je speelt. Lees ook onze gids over legale online casino\u2019s.',
  },
  {
    q: 'Wat is de beste betaalmethode bij een online casino?',
    a: 'In Nederland is iDEAL veruit de populairste methode: stortingen worden direct verwerkt en er zijn geen kosten. Uitbetalingen gaan via een directe bankbetaling terug naar dezelfde rekening, bij de snelste aanbieders binnen enkele minuten.',
  },
  {
    q: 'Hoe snel betaalt een online casino uit?',
    a: 'Dat verschilt per aanbieder. De snelste legale casino\u2019s (zoals Jacks.nl en Casino777) betalen via Instant Payments binnen 1 tot 5 minuten uit. Andere aanbieders hanteren een verwerkingstijd van 12 tot 24 uur.',
  },
  {
    q: 'Wat is Cruks?',
    a: 'Cruks is het Centraal Register Uitsluiting Kansspelen. Wie zich hierin inschrijft, kan minimaal 6 maanden niet spelen bij legale aanbieders van kansspelen in Nederland \u2014 online \u00E9n in fysieke casino\u2019s.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Beste online casino\u2019s Nederland',
    itemListElement: casinos.map((c) => ({
      '@type': 'ListItem',
      position: c.rank,
      name: c.name,
    })),
  },
];
---

<Base
  title="Beste Legale Online Casino's Nederland 2026 | CasinoHelder"
  description="Vergelijk legale online casino's met KSA-vergunning. Onafhankelijke reviews, snelle uitbetaling en iDEAL. Alleen 24+."
  schema={schema}
>
  <section class="hero">
    <div class="container">
      <h1>Beste legale online casino&rsquo;s van Nederland &ndash; 2026</h1>
      <p>
        Onafhankelijke vergelijking van online casino&rsquo;s voor Nederlandse spelers.
        Wij testen stortingen, uitbetaaltijden en bonusvoorwaarden, zodat jij bewust kunt kiezen.
      </p>
      <div class="hero__badges">
        <span class="hero__badge">&#10003; Uitbetaaltijden zelf getest</span>
        <span class="hero__badge">&#10003; Bonusvoorwaarden beoordeeld</span>
        <span class="hero__badge">&#10003; Onafhankelijke redactie</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" style="margin-top:0">Exclusieve casino bonussen &ndash; september 2026</h2>
      <p class="section-sub">
        Laatst bijgewerkt: september 2026 &middot; Actuele welkomstaanbiedingen, wekelijks
        gecontroleerd door onze redactie.
      </p>

      <div class="casino-list">
        {
          casinos.map((c) => (
            <div class="casino-card">
              <img
                class="casino-card__logo"
                src={c.logo}
                alt={`${c.name} logo`}
                width="116"
                height="64"
                loading="lazy"
              />
              <div>
                <p class="casino-card__name">{c.name}</p>
                <ul class="casino-card__meta">
                  <li>&#127873; <strong>{c.bonus}</strong></li>
                  <li>&#11088; {c.usp}</li>
                  <li>&#128737;&#65039; {c.license}</li>
                  <li><a href={c.review}>Lees onze review &rarr;</a></li>
                  <li>18+ &middot; Bonusvoorwaarden van toepassing</li>
                </ul>
              </div>
              <a
                class="btn"
                href={c.link}
                rel="sponsored nofollow noopener"
                target="_blank"
              >
                Claim bonus
              </a>
            </div>
          ))
        }
      </div>

      <div class="rg-banner">
        <strong>Gokken kan verslavend zijn. Speel bewust. 24+</strong> &mdash; Stel voor het
        spelen altijd je eigen limieten in. Hulp nodig? Kijk op
        <a href="/verantwoord-spelen/">onze pagina over verantwoord spelen</a>.
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2 class="section-title" style="margin-top:0">Gidsen &amp; uitleg</h2>
      <p class="section-sub">
        Praktische antwoorden op de meest gestelde vragen over legaal online spelen in Nederland.
      </p>
      <div class="grid-3">
        {
          gidsen.map((g) => (
            <a class="article-card" href={`/gidsen/${g.id}/`}>
              <span class="article-card__cat">{g.data.category}</span>
              <h3>{g.data.title}</h3>
              <p>{g.data.description}</p>
              <span class="article-card__more">Lees verder &rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <h2 style="margin-top:0">Zo vergelijken wij online casino&rsquo;s</h2>
      <p>
        Elk casino op CasinoHelder.nl doorloopt dezelfde beoordeling. We controleren eerst de
        <strong>licentie</strong> van de aanbieder en vermelden die transparant bij elke
        vergelijking. Daarna beoordelen we het <strong>spelaanbod</strong>, de
        <strong>uitbetalingsvoorwaarden</strong> en de <strong>bonusvoorwaarden</strong>:
        hoe hoog zijn de inzetvereisten en hoe transparant communiceert de aanbieder daarover?
      </p>
      <p>
        <strong>Let op:</strong> aanbieders met een internationale licentie vallen niet onder
        het toezicht van de Nederlandse Kansspelautoriteit. Dat betekent geen Cruks-koppeling
        en geen bescherming onder Nederlandse kansspelwetgeving. Lees onze gids over
        <a href="/gidsen/legale-online-casinos-nederland/">legale casino&rsquo;s in Nederland</a>
        en maak een bewuste keuze. Speel alleen met geld dat je kunt missen.
      </p>

      <h2>Veelgestelde vragen</h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
