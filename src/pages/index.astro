---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const gidsen = (await getCollection('gidsen')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const casinos = [
  {
    rank: 1,
    name: 'Jacks.nl',
    usp: 'Snelste uitbetaling in onze test',
    deposit: '\u20AC10 via iDEAL',
    payout: '1\u20135 minuten',
    license: 'KSA-vergunning',
  },
  {
    rank: 2,
    name: 'Casino777',
    usp: 'Lage minimale storting',
    deposit: '\u20AC5 via iDEAL, PayPal, Paysafecard',
    payout: 'Binnen 3 minuten (Instant Payment)',
    license: 'KSA-vergunning',
  },
  {
    rank: 3,
    name: 'TOTO Casino',
    usp: 'Bekend Nederlands merk',
    deposit: '\u20AC5 via iDEAL',
    payout: 'Binnen 24 uur',
    license: 'KSA-vergunning',
  },
  {
    rank: 4,
    name: 'Betnation',
    usp: 'Volledig \u20AC5-casino',
    deposit: '\u20AC5 via iDEAL of Visa',
    payout: 'Binnen 24 uur',
    license: 'KSA-vergunning',
  },
  {
    rank: 5,
    name: 'Vbet',
    usp: 'Minimale uitbetaling van \u20AC1',
    deposit: '\u20AC5 via iDEAL of Trustly',
    payout: 'Maximaal 12 uur',
    license: 'KSA-vergunning (nr. 2187)',
  },
];

const faq = [
  {
    q: 'Welke online casino\u2019s zijn legaal in Nederland?',
    a: 'Alleen aanbieders met een vergunning van de Kansspelautoriteit (KSA) mogen legaal online kansspelen aanbieden in Nederland. Je herkent ze aan het KSA-logo met vergunningsnummer in de footer van de website. Op deze pagina vergelijken wij uitsluitend legale aanbieders.',
  },
  {
    q: 'Wat is de beste betaalmethode bij een online casino?',
    a: 'In Nederland is iDEAL veruit de populairste methode: stortingen worden direct verwerkt en er zijn geen kosten. Uitbetalingen gaan via een directe bankbetaling terug naar dezelfde rekening, bij de snelste aanbieders binnen enkele minuten.',
  },
  {
    q: 'Hoe snel betaalt een online casino uit?',
    a: 'Dat verschilt per aanbieder. De snelste legale casino\u2019s (zoals Jacks.nl en Casino777) betalen via Instant Payments binnen 1 tot 5 minuten uit. Andere aanbieders hanteren een verwerkingstijd van 12 tot 24 uur.',
  },
  {
    q: 'Wat is Cruks?',
    a: 'Cruks is het Centraal Register Uitsluiting Kansspelen. Wie zich hierin inschrijft, kan minimaal 6 maanden niet spelen bij legale aanbieders van kansspelen in Nederland \u2014 online \u00E9n in fysieke casino\u2019s.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Beste legale online casino\u2019s Nederland',
    itemListElement: casinos.map((c) => ({
      '@type': 'ListItem',
      position: c.rank,
      name: c.name,
    })),
  },
];
---

<Base
  title="Beste Legale Online Casino's Nederland 2026 | CasinoHelder"
  description="Vergelijk legale online casino's met KSA-vergunning. Onafhankelijke reviews, snelle uitbetaling en iDEAL. Alleen 24+."
  schema={schema}
>
  <section class="hero">
    <div class="container">
      <h1>Beste legale online casino&rsquo;s van Nederland &ndash; 2026</h1>
      <p>
        Onafhankelijke vergelijking van casino&rsquo;s met een Nederlandse KSA-vergunning.
        Wij testen stortingen, uitbetaaltijden en bonusvoorwaarden, zodat jij veilig kunt kiezen.
      </p>
      <div class="hero__badges">
        <span class="hero__badge">&#10003; Alleen KSA-vergunde aanbieders</span>
        <span class="hero__badge">&#10003; Uitbetaaltijden zelf getest</span>
        <span class="hero__badge">&#10003; Storten met iDEAL</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title" style="margin-top:0">Top 5 legale online casino&rsquo;s</h2>
      <p class="section-sub">
        Laatst bijgewerkt: augustus 2026 &middot; Alle aanbieders hebben een vergunning van de
        Kansspelautoriteit.
      </p>

      <div class="casino-list">
        {
          casinos.map((c) => (
            <div class="casino-card">
              <div class="casino-card__rank">#{c.rank}</div>
              <div>
                <p class="casino-card__name">{c.name}</p>
                <ul class="casino-card__meta">
                  <li>&#11088; <strong>{c.usp}</strong></li>
                  <li>&#128179; Storting: {c.deposit}</li>
                  <li>&#9201;&#65039; Uitbetaling: {c.payout}</li>
                  <li>&#128737;&#65039; {c.license}</li>
                </ul>
              </div>
              <a class="btn" href="/gidsen/legale-online-casinos-nederland/" rel="nofollow">
                Bekijk review
              </a>
            </div>
          ))
        }
      </div>

      <div class="rg-banner">
        <strong>Gokken kan verslavend zijn. Speel bewust. 24+</strong> &mdash; Stel voor het
        spelen altijd je eigen limieten in. Hulp nodig? Kijk op
        <a href="/verantwoord-spelen/">onze pagina over verantwoord spelen</a>.
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2 class="section-title" style="margin-top:0">Gidsen &amp; uitleg</h2>
      <p class="section-sub">
        Praktische antwoorden op de meest gestelde vragen over legaal online spelen in Nederland.
      </p>
      <div class="grid-3">
        {
          gidsen.map((g) => (
            <a class="article-card" href={`/gidsen/${g.id}/`}>
              <span class="article-card__cat">{g.data.category}</span>
              <h3>{g.data.title}</h3>
              <p>{g.data.description}</p>
              <span class="article-card__more">Lees verder &rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <h2 style="margin-top:0">Zo vergelijken wij online casino&rsquo;s</h2>
      <p>
        Elk casino op CasinoHelder.nl doorloopt dezelfde test. We controleren eerst de
        <strong>KSA-vergunning</strong> in het openbare register van de Kansspelautoriteit.
        Daarna maken we zelf een account aan, storten we via iDEAL en vragen we een
        uitbetaling aan om de werkelijke <strong>uitbetaaltijd</strong> te meten. Tot slot
        beoordelen we de <strong>bonusvoorwaarden</strong>: hoe hoog zijn de inzetvereisten
        en hoe transparant communiceert de aanbieder daarover?
      </p>
      <p>
        Aanbieders zonder Nederlandse vergunning nemen wij niet op in onze vergelijkingen
        &mdash; ongeacht de commissie die zij bieden. Spelen bij een illegale aanbieder betekent
        geen bescherming door Nederlandse wetgeving, geen Cruks-koppeling en geen garantie
        dat je winst wordt uitbetaald.
      </p>

      <h2>Veelgestelde vragen</h2>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
